-- staker_actor_bind.script
-- Бинд для актера: устанавливает группировку, ранг и репутацию при создании

local bit = require("bit")

stalker = {
    obj = nil,
}

function stalker:init(obj)
    self.obj = obj
end

function stalker:birth()
    -- Эта функция вызывается при создании объекта (спавне)
    -- Проверяем, что это именно игрок (хотя бинд вешается только на него через конфиг)
    if self.obj then
        -- Устанавливаем группировку: Долг (army)
        self.obj:set_character_community("army", 0, 0)

        -- Устанавливаем репутацию: 1000
        self.obj:set_reputation(1000)

        -- Устанавливаем ранг: 1000
        self.obj:set_rank(1000)

        print("Staker Mod: Игрок создан. Группировка: ДОЛГ, Репутация: 1000, Ранг: 1000.")
    end
end

function stalker:destroy()
    self.obj = nil
end

function stalker:update()
    -- Пусто, ничего не делаем каждый тик
end

function stalker:hit(hit)
    -- Стандартная обработка урона (можно оставить пустой для передачи движку или скопировать из xr_bind_stalker)
    -- Для простоты оставим пустым, движок сам обработает, если не перехватывать
end

function stalker:use(object)
    return false
end

function stalker:can_select_weapon()
    return true
end
